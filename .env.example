# Retail Memory Shopping Assistant — environment template
# Copy to .env and fill in your own values. Never commit .env.

# --- Product catalogue API (FastAPI) ---
PRODUCT_API_URL=http://localhost:8000

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# --- Query router (Jev / TypeSafe System One) ---
# API key from the TypeSafe console. Sent as: Authorization: Bearer <key>
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT_SECONDS=2
ROUTER_USE_JEV=true
ROUTER_CONFIDENCE_THRESHOLD=0.5
# Turns of conversation sent to Jev (never memories or customer ids).
ROUTER_SEND_HISTORY_TURNS=2

# --- Mem0 Cloud MCP ---
# Official hosted MCP endpoint (Streamable HTTP transport).
MEM0_MCP_URL=https://mcp.mem0.ai/mcp
# API key from https://app.mem0.ai/dashboard/api-keys
# Sent as: Authorization: Token <MEM0_API_KEY>
MEM0_API_KEY=
MEM0_TIMEOUT_SECONDS=30
# Mem0 writes are asynchronous: poll the event until it finishes.
MEMORY_EVENT_TIMEOUT_SECONDS=15
MEMORY_EVENT_POLL_INTERVAL_SECONDS=1

# --- Application ---
APP_ENV=development
MAX_RECOMMENDATIONS=5
MEMORY_TOP_K=20
